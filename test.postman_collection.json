		{
			"name": "Weryfikacja admina",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code dla weryfikacji admina to 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Weryfikacja roli administratora\", function () {",
							"    const response = pm.response.json();",
							"    ",
							"    pm.expect(response).to.have.property('success', true);",
							"    pm.expect(response.user).to.have.property('role', 'admin');",
							"});",
							"",
							"// Test dostępu do zasobów administracyjnych",
							"if (pm.response.code === 200) {",
							"    const adminEndpoints = [",
							"        '/api/users/list',",
							"        '/api/admin/stats',",
							"        '/api/users/deactivate/someUserId'",
							"    ];",
							"    ",
							"    adminEndpoints.forEach(endpoint => {",
							"        pm.sendRequest({",
							"            url: pm.environment.get(\"baseUrl\") + endpoint,",
							"            method: 'GET',",
							"            header: {",
							"                'Authorization': 'Bearer ' + pm.environment.get(\"adminToken\")",
							"            }",
