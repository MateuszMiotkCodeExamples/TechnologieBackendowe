							"    pm.expect(response).to.have.property('pagination');",
							"});",
							"",
							"pm.test(\"Paginacja działa poprawnie\", function () {",
							"    const response = pm.response.json();",
							"    const requestedLimit = parseInt(pm.request.url.query.get('limit')) || 10;",
							"    ",
							"    pm.expect(response.users.length).to.be.at.most(requestedLimit);",
							"    pm.expect(response.pagination).to.include.all.keys('current', 'total', 'totalRecords');",
