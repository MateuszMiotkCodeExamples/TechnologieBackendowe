		{
			"name": "Registration",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Sprawdzenie statusu i struktury odpowiedzi",
							"pm.test(\"Status code dla poprawnej rejestracji to 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Odpowiedź zawiera prawidłowe pola\", function () {",
							"    const response = pm.response.json();",
							"    ",
							"    pm.expect(response).to.have.property('success');",
							"    pm.expect(response).to.have.property('token');",
							"    pm.expect(response).to.have.property('user');",
							"    pm.expect(response.user).to.have.property('email');",
							"    pm.expect(response.user).to.have.property('role');",
							"});",
							"",
							"pm.test(\"Token jest prawidłowym stringiem\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response.token).to.be.a('string').and.to.have.lengthOf.above(10);",
							"});",
							"",
							"// Zapisanie tokenu do zmiennych środowiskowych",
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    pm.environment.set(\"userToken\", response.token);",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
